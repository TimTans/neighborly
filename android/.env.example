# Supabase configuration
# Copy this file to .env and fill in your project values.
# Get these from: https://supabase.com/dashboard/project/_/settings/api

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
API_BASE_URL=http://10.0.2.2:8000

# Mapbox access token (sk.* with Downloads:Read scope) -- used at runtime for
# map tiles and Directions API, and by Gradle to pull the Mapbox SDK.
MAPBOX_ACCESS_TOKEN=
